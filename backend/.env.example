# ---------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------

# Postgres connection string. Local:
#   postgresql://postgres:yourpassword@localhost:5432/focus_tracker
# Supabase: use the session pooler string (port 5432,
# *.pooler.supabase.com), not the direct/IPv6 one - see HANDOVER.md.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/focus_tracker

# Signs the session cookie. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotation: put the new secret first and keep the old one after a comma
# (NEW,OLD). Existing sessions stay valid; drop OLD after 30 days.
# Left blank on purpose - the app refuses to start without it.
SESSION_SECRET=

# Comma-separated allowed frontend origins. "*" only works outside
# production; in production the app refuses to start with it. Also used
# to reject cross-site (CSRF) requests.
#   CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=*

# Where links in emails and OAuth redirects send people (your deployed
# frontend), e.g. https://your-app.vercel.app
FRONTEND_URL=

# ---------------------------------------------------------------------
# Strongly recommended in production
# ---------------------------------------------------------------------

# Encrypts Google OAuth tokens and MFA secrets in the database
# (AES-256-GCM). 32 bytes as 64 hex characters - generate the same way as
# SESSION_SECRET. Keep a copy in your password manager: if it's lost,
# connected Google Calendars must be reconnected and MFA re-enrolled.
TOKEN_ENCRYPTION_KEY=

# The database server's CA certificate (PEM). With it, the TLS connection
# is verified; without it, it's encrypted but not authenticated.
# Supabase: Project Settings -> Database -> SSL Configuration -> download.
# Paste with literal \n for newlines if your host needs a single line.
DATABASE_SSL_CA=

# Shared secret for GET/POST /api/cron/tick. Send it as the
# x-cron-secret header (cron-job.org: "Advanced" -> headers). The old
# ?secret= query form still works but is logged as a warning, because
# URLs end up in logs.
CRON_SECRET=

# ---------------------------------------------------------------------
# Email (password reset). Without these, reset links are printed to the
# server log in development and can't be sent in production (the
# "Forgot password?" link is hidden).
# ---------------------------------------------------------------------
RESEND_API_KEY=
# A verified sender on a domain with SPF + DKIM + DMARC set up in Resend,
# e.g. FocusDial <no-reply@mail.yourdomain.com>
MAIL_FROM=

# ---------------------------------------------------------------------
# Optional tuning (defaults shown)
# ---------------------------------------------------------------------
PORT=4000
# Apply pending migrations at startup. Set to false if you run
# `npm run migrate` as a separate deploy step instead.
MIGRATE_ON_BOOT=true
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000
SESSION_IDLE_DAYS=14
SESSION_ABSOLUTE_DAYS=30
# Reverse proxies in front of the app (Render: 1). Wrong values let
# clients spoof their IP and dodge rate limits.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------
# Push notifications (optional): npx web-push generate-vapid-keys
# ---------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------
# Google Calendar sync + "Sign in with Google" (optional)
# ---------------------------------------------------------------------
# 1. Google Cloud Console > APIs & Services > enable "Google Calendar API".
# 2. Credentials > OAuth client ID > Web application.
# 3. Add BOTH redirect URIs below as Authorized redirect URIs.
# 4. OAuth consent screen: "Testing" mode is limited to 100 listed test
#    users and its refresh tokens expire after 7 days - publish/verify
#    the app before real users connect calendars (see OPERATIONS.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. https://your-backend.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# e.g. https://your-backend.onrender.com/api/auth/google/login/callback
GOOGLE_LOGIN_REDIRECT_URI=
