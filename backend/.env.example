# Postgres connection string. For local dev with a local Postgres install,
# something like:
#   postgresql://postgres:yourpassword@localhost:5432/focus_tracker
# For Supabase, use the session pooler string (port 5432,
# *.pooler.supabase.com) rather than the direct/IPv6 one — see HANDOVER.md.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/focus_tracker

# Render/Railway/Fly inject this automatically in production. Only set it
# yourself for local dev, and even then the default (4000) is fine to
# leave alone.
PORT=4000

# Comma-separated allowed CORS origins. "*" is fine for local dev, but
# the app refuses to start with "*" when NODE_ENV=production — set this
# to your real Vercel URL(s) before deploying, e.g.
# CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=*

# --- Accounts (required — this app has real user accounts, not a
# single shared instance) ---
# Signs and encrypts the session cookie. Required at startup — the app
# refuses to boot without it, since a missing/default secret here would
# mean anyone could forge a session for any account. Generate a real
# random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Left blank rather than a placeholder on purpose — see the
# GOOGLE_REDIRECT_URI note below for why.
SESSION_SECRET=

# --- Push notifications (optional — app works without these, just with
# no push capability) ---
# Generate a key pair once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret checked against the ?secret= query param or
# x-cron-secret header on GET/POST /api/cron/tick. Set this to something
# random, then point an external scheduler (e.g. cron-job.org — Render's
# free tier has no built-in cron) at that URL every few minutes. Without
# this endpoint being called periodically, reminders/automation never
# fire — the backend has no way to check on its own while idle.
CRON_SECRET=

# --- Google Calendar two-way sync (optional — app works without these,
# the "Connect Google Calendar" control in Settings just shows as
# "not set up" instead) ---
# 1. Google Cloud Console > APIs & Services > enable the "Google
#    Calendar API".
# 2. Credentials > Create Credentials > OAuth client ID > Web application.
# 3. Add GOOGLE_REDIRECT_URI's value (below) as an Authorized redirect URI.
# 4. OAuth consent screen: "Testing" mode is fine for personal use —
#    add your own Google account under "Test users" and skip Google's
#    full verification process, which isn't needed for a single-user app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI configured in step 3
# above, and must be reachable from a browser (not a bare LAN IP) —
# something like https://your-backend.onrender.com/api/auth/google/callback
# once deployed. Left blank rather than a live-looking placeholder — see
# HANDOVER.md's note on the logistics dashboard's VITE_API_URL mistake,
# same reasoning applies here.
GOOGLE_REDIRECT_URI=
# Where the browser is sent back to once the OAuth handshake finishes
# (your deployed frontend's URL). Falls back to a relative redirect if
# left unset, which only works when frontend and backend share an origin.
FRONTEND_URL=

# --- "Sign in with Google" (optional — email/password signup still
# works without this; it just hides the "Continue with Google" button
# on the login screen) ---
# A *second*, separate redirect URI on the same OAuth client as above —
# logging in shouldn't require granting calendar access, so this uses its
# own narrower scope (just email/profile) and its own callback route.
# Add this one as an additional Authorized redirect URI alongside
# GOOGLE_REDIRECT_URI in the same Google Cloud Console client (Google
# allows multiple redirect URIs per client) — something like
# https://your-backend.onrender.com/api/auth/google/login/callback
# once deployed.
GOOGLE_LOGIN_REDIRECT_URI=
